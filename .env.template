# Smart Glasses Intelligence Platform
# ==================================
# Copy this file to `.env` and fill values needed for the current phase.
# Keep `.env` out of git. Treat it as data: never source or execute it in a shell.

# ------------------------------
# Global app / runtime
# ------------------------------
ENVIRONMENT=dev
LOG_LEVEL=info
APP_PORT=8080
APP_BASE_URL=https://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_LOCALE=en-US

# ------------------------------
# Google Cloud / Firebase (REQUIRED CORE)
# ------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_ORGANIZATION_ID=
GCP_BILLING_ACCOUNT_ID=
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_EMAIL=

# Use either one of:
# 1) GOOGLE_APPLICATION_CREDENTIALS path (recommended for local/dev)
# 2) GOOGLE_SERVICE_ACCOUNT_KEY_JSON (json string/base64 payload for CI)
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# BigQuery
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_SMART_GLASSES=
BIGQUERY_LOCATION=

# Firestore
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=smart_glasses

# Cloud Storage
STORAGE_DEFAULT_BUCKET=
CLOUD_STORAGE_REGION=

# Cloud Scheduler / Tasks
CLOUD_SCHEDULER_REGION=
CLOUD_SCHEDULER_TIMEZONE=UTC

# ------------------------------
# Firebase Web + Admin SDK
# ------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_AUTH_EMULATOR_HOST=

# Firebase admin/service credentials (one is fine)
FIREBASE_ADMIN_CREDENTIAL_PATH=
FIREBASE_ADMIN_CREDENTIAL_JSON=
FIREBASE_SIGNING_SERVICE_ACCOUNT_EMAIL=

# ------------------------------
# AI / Agent runtime
# ------------------------------
AGENT_RUNTIME_STACK=python
AGENT_RUNTIME_ENV=dev

# Choose provider per service
LLM_PROVIDER=openai
LLM_MODEL_SMALL=
LLM_MODEL_LARGE=
LLM_REQUEST_TIMEOUT_SECONDS=60

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# Gemini image fallback
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MEDIA_CATALOG_PATH=.local/media-catalog/catalog.sqlite3

# Vertex AI (optional alternative)
VERTEX_PROJECT_ID=
VERTEX_REGION=
VERTEX_LOCATION=
VERTEX_ADMINS_API_KEY=

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=

# ------------------------------
# Content rendering & media
# ------------------------------
PLAYWRIGHT_EXECUTABLE_PATH=
FFMPEG_PATH=
VIDEO_OUTPUT_BUCKET=
VIDEO_MAX_DURATION_SECONDS=240
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_WATERMARK_TEXT=

# TTS / captions
TTS_PROVIDER=google
GOOGLE_TTS_CREDENTIALS_PATH=
ELEVENLABS_API_KEY=
AZURE_TTS_ENDPOINT=
AZURE_TTS_API_KEY=

# ------------------------------
# Publishing: Social adapters
# ------------------------------
# At least one adapter must be fully configured before publish jobs can be enabled.

PUBLISHER_DEFAULT_CHANNEL=manual
PUBLISHER_CHANNELS_ENABLED=youtube,linkedin,manual
PUBLISHER_WEBHOOK_SECRET=

# YouTube Data API (video upload + analytics)
YOUTUBE_API_CLIENT_ID=
YOUTUBE_API_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://localhost:8080/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token
YOUTUBE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
YOUTUBE_API_SCOPE="https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly"
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_REUSE_QUOTA_BUFFER=

# Legacy/alternate Google credential style
# If your OAuth app only exposes GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, fill these too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
YOUTUBE_API_KEY=

# LinkedIn API (UGC posts / media)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://localhost:8080/auth/linkedin/callback
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_AUTHOR_URN=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Manual posting package fallback
DEFAULT_MANUAL_PACKAGE_STORAGE_PREFIX=manual-packages

# ------------------------------
# Source policy and ingestion
# ------------------------------
ALLOWED_SOURCE_DOMAINS=
BLOCKED_SOURCE_DOMAINS=
SCRAPE_RATE_LIMIT_PER_MIN=60
SCRAPE_USER_AGENT=

# Provider-neutral source discovery. All are optional; start with free trials.
# Search results are discovery-only and never become assertions by themselves.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Deferred bulk provider. Leave blank until benchmark results justify its minimum deposit.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Reddit remains disabled until explicit written commercial approval exists.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_COMMERCIAL_APPROVAL_REFERENCE=

# ------------------------------
# Gmail API (Google Alerts discovery; read-only OAuth)
# ------------------------------
# Prefer a dedicated OAuth client. The setup script may fall back to the
# existing GDRIVE OAuth client when these are blank.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GMAIL_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.readonly
GMAIL_OAUTH_TOKEN_PATH=.local/gmail-alerts/oauth-token.json
GMAIL_ALERT_QUERY=from:googlealerts-noreply@google.com ("smart glasses" OR "AR glasses" OR "AI glasses")

# ------------------------------
# Email / SMTP (optional)
# ------------------------------
# SMTP sends mail; it is not used to read Google Alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------
# Google Drive (optional review export)
# ------------------------------
GDRIVE_FOLDER_ID=
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# ------------------------------
# Discord bot (optional integration)
# ------------------------------
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ------------------------------
# GitHub (repo / pipeline)
# ------------------------------
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main
# Optional locally when `gh auth status` succeeds through the OS keychain.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WORKFLOW_ENV=production
CI_PROVIDER=github

# ------------------------------
# Security / auth / web app
# ------------------------------
APP_SECRET_KEY=
SESSION_COOKIE_NAME=sgip_session
JWT_SECRET=
ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=60

# ------------------------------
# Optional observability
# ------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9464

# ------------------------------
# Feature flags / rollout
# ------------------------------
ENABLE_AGENT_RUNTIME=true
ENABLE_PUBLISH_AUTOMATION=false
ENABLE_METRICS_IMPORT=true
ENABLE_RENDER_WORKER=true

# ------------------------------
# Local stack / container settings
# ------------------------------
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest
LOCAL_WORKSPACE=/absolute/path/to/SmartGlasses
POSTGRES_ENABLED=false
REDIS_ENABLED=false

# ------------------------------
# File upload / size limits
# ------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp,mp4,mov,pdf,csv,json

# ------------------------------
# CORS / admin domains
# ------------------------------
ADMIN_ALLOWED_EMAIL_DOMAINS=
TRUSTED_ORIGINS=
# Local/API object workflow
OBJECT_STORE_PATH=.local/object-events.jsonl
API_WRITE_TOKEN=
